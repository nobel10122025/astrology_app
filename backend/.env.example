# Copy to .env (local) or set these as environment variables on your host
# (e.g. Render dashboard) for deployment. .env is gitignored.

# --- LLM provider selection --------------------------------------------------
# groq (default) | anthropic | ollama. Controls the narrator; the judge/planner
# use Groq (optionally via Portkey, below).
LLM_PROVIDER=groq

# --- Groq (free-tier, OpenAI-compatible) -------------------------------------
GROQ_API_KEY=your-groq-key
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant

# --- Portkey AI gateway (optional) -------------------------------------------
# When PORTKEY_API_KEY is set, all Groq calls (judge, narrator, tool planner)
# are routed through Portkey for observability, caching, retries and fallbacks.
# Leave PORTKEY_API_KEY unset to talk to Groq directly (default).
# PORTKEY_API_KEY=your-portkey-api-key
#
# Pick ONE way for Portkey to reach Groq:
#   (a) Model catalog (recommended - matches Portkey's quickstart). Create an
#       integration in the Portkey dashboard, attach your Groq key to it, and
#       set its slug here. The Groq key then lives in Portkey; you can drop
#       GROQ_API_KEY above. Models are auto-addressed as "@<slug>/<model>".
# PORTKEY_SLUG=astrology-app-key
#   (b) Virtual key (older header form) - Portkey stores the Groq key:
# PORTKEY_VIRTUAL_KEY=your-portkey-virtual-key
#   (c) Pass-through - GROQ_API_KEY above is forwarded; name the provider:
# PORTKEY_PROVIDER=groq
#
# Optional: a saved Portkey config id (routing/fallback/cache defined in the
# Portkey dashboard).
# PORTKEY_CONFIG=your-portkey-config-id

# --- Anthropic (only if LLM_PROVIDER=anthropic) ------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama (only if LLM_PROVIDER=ollama; local narration) -------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma2
